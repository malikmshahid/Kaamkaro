# JWT signing secret — production mein random secure string set karein
JWT_SECRET=change-me-in-production

# Postgres connection string — Neon.tech (free tier) se milegi
# Local testing ke liye: postgresql://postgres:password@localhost:5432/kaamkaro
DATABASE_URL=

# Anthropic API key — Phase 4 ke AI photo verification ke liye
# Agar ye set nahi hai, verification "review_needed" return karega (manual check ka signal)
# Key yahan se milegi: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
