# Your deployed site URL, used for sitemap.xml/robots.txt (optional locally)
NEXT_PUBLIC_SITE_URL=

# JWT signing secret — set a random secure string in production
JWT_SECRET=change-me-in-production

# Postgres connection string — get one free from Neon.tech
# For local testing: postgresql://postgres:password@localhost:5432/kaamkaro
DATABASE_URL=

# Anthropic API key — used for Phase 4's AI photo verification
# If unset, verification returns "review_needed" (a manual-check signal) instead of failing
# Get a key here: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
